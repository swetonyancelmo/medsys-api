# Copie para .env e preencha. O .env já está no .gitignore.
# Para carregar no terminal: set -a && . ./.env && set +a

# Obrigatório. Gere com: openssl rand -base64 32
JWT_SECRET=

# Opcionais (os valores abaixo batem com o docker-compose de desenvolvimento)
DB_PASSWORD=admin
JWT_EXPIRATION_MS=86400000
